<Slide style={{ width: '1280px', height: '720px', background: '#0F172A', padding: '20px 60px 20px 60px', justifyContent: 'space-between' }}>
  <Box style={{ height: '80px', justifyContent: 'center' }}>
    <Text style={{ fontSize: 36, fontWeight: 'bold', color: '#3B82F6' }}>Why It's an Agent</Text>
  </Box>
  <Box style={{ flexDirection: 'row', gap: '40px', height: '520px' }}>
    <Box style={{ width: '320px', flexDirection: 'column', gap: '20px', justifyContent: 'center' }}>
      <Text style={{ fontSize: 22, color: '#F1F5F9', lineHeight: 1.6 }}>Every tool returns a result or a list of problems.</Text>
      <Text style={{ fontSize: 22, color: '#94A3B8', lineHeight: 1.6 }}>The agent fixes them and tries again.</Text>
      <Text style={{ fontSize: 22, color: '#94A3B8', lineHeight: 1.6 }}>LLM or rule-based planner. Same checks.</Text>
      <Text style={{ fontSize: 22, color: '#3B82F6', fontWeight: 'bold', lineHeight: 1.6 }}>Can't stop halfway.</Text>
    </Box>
    <Box style={{ width: '800px', justifyContent: 'center', alignItems: 'center' }}>
      <svg width={800} height={480} viewBox='0 0 800 480'>
        <rect x='10' y='60' width='120' height='60' rx='8' fill='#3B82F6' />
        <text x='70' y='96' text-anchor='middle' fill='#F1F5F9' font-size='20' font-weight='bold'>Goal</text>
        <rect x='165' y='60' width='120' height='60' rx='8' fill='#3B82F6' />
        <text x='225' y='96' text-anchor='middle' fill='#F1F5F9' font-size='20' font-weight='bold'>Plan</text>
        <rect x='320' y='60' width='120' height='60' rx='8' fill='#3B82F6' />
        <text x='380' y='96' text-anchor='middle' fill='#F1F5F9' font-size='20' font-weight='bold'>Tools</text>
        <rect x='475' y='60' width='120' height='60' rx='8' fill='#10B981' />
        <text x='535' y='96' text-anchor='middle' fill='#F1F5F9' font-size='20' font-weight='bold'>Verify</text>
        <rect x='630' y='60' width='120' height='60' rx='8' fill='#3B82F6' />
        <text x='690' y='96' text-anchor='middle' fill='#F1F5F9' font-size='20' font-weight='bold'>Deliver</text>
        <rect x='395' y='230' width='120' height='60' rx='8' fill='#1E40AF' />
        <text x='455' y='266' text-anchor='middle' fill='#F1F5F9' font-size='20' font-weight='bold'>Fix</text>
        <line x1='130' y1='90' x2='158' y2='90' stroke='#64748B' strokeWidth='3' />
        <polygon points='158,83 172,90 158,97' fill='#64748B' />
        <line x1='285' y1='90' x2='313' y2='90' stroke='#64748B' strokeWidth='3' />
        <polygon points='313,83 327,90 313,97' fill='#64748B' />
        <line x1='440' y1='90' x2='468' y2='90' stroke='#64748B' strokeWidth='3' />
        <polygon points='468,83 482,90 468,97' fill='#64748B' />
        <line x1='595' y1='90' x2='623' y2='90' stroke='#64748B' strokeWidth='3' />
        <polygon points='623,83 637,90 623,97' fill='#64748B' />
        <path d='M 535 120 Q 535 175 465 225' fill='none' stroke='#10B981' strokeWidth='3' strokeDasharray='6 3' />
        <polygon points='458,218 465,232 474,224' fill='#10B981' />
        <path d='M 395 260 Q 375 175 365 128' fill='none' stroke='#10B981' strokeWidth='3' strokeDasharray='6 3' />
        <polygon points='358,133 365,119 374,131' fill='#10B981' />
        <text x='548' y='170' fill='#10B981' font-size='15'>if problems</text>
        <text x='340' y='195' fill='#10B981' font-size='15'>retry</text>
        <text x='535' y='148' text-anchor='middle' fill='#94A3B8' font-size='14'>gate</text>
        <text x='400' y='360' text-anchor='middle' fill='#94A3B8' font-size='16'>Each tool returns a result or a list of specific problems</text>
        <text x='400' y='388' text-anchor='middle' fill='#94A3B8' font-size='16'>Agent fixes problems and retries until checks pass</text>
        <text x='400' y='424' text-anchor='middle' fill='#F1F5F9' font-size='17' font-weight='bold'>LLM or rule-based planner, same checks</text>
        <text x='400' y='460' text-anchor='middle' fill='#3B82F6' font-size='17' font-weight='bold'>MCP tool only returns when verified</text>
      </svg>
    </Box>
  </Box>
  <Box style={{ height: '40px', flexDirection: 'row', justifyContent: 'space-between', alignItems: 'flex-end' }}>
    <Text style={{ fontSize: 14, color: '#475569' }}>HireBuddy</Text>
    <Text style={{ fontSize: 14, color: '#475569' }}>03 / 05</Text>
  </Box>
</Slide>
