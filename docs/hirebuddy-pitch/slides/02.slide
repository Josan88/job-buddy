<Slide style={{ width: '1280px', height: '720px', background: '#0F172A', padding: '20px 60px 20px 60px', justifyContent: 'space-between' }}>
  <Box style={{ height: '80px', justifyContent: 'center' }}>
    <Text style={{ fontSize: 36, fontWeight: 'bold', color: '#3B82F6' }}>One Prompt</Text>
  </Box>
  <Box style={{ flexDirection: 'row', gap: '40px', height: '520px', alignItems: 'center' }}>
    <Box style={{ width: '720px', borderLeft: '4px solid #3B82F6', paddingLeft: '24px', flexDirection: 'column' }}>
      <Text style={{ fontSize: 26, color: '#F1F5F9', lineHeight: 1.6, fontStyle: 'italic' }}>
        "I'm Nadia Rahim. I'm blind and use NVDA. I live in Subang Jaya and take the LRT. I did customer service calls at a bank hotline for a year and type fast in English and Malay. Free weekdays 9am to 5pm, at least RM12 an hour, phone interviews please."
      </Text>
    </Box>
    <Box style={{ width: '400px', flexDirection: 'column', gap: '24px' }}>
      <Text style={{ fontSize: 22, color: '#94A3B8', lineHeight: 1.5 }}>
        That's everything she types. She doesn't answer any more questions.
      </Text>
      <Box style={{ flexDirection: 'column', gap: '14px' }}>
        <Box style={{ flexDirection: 'row', gap: '12px', alignItems: 'center' }}>
          <Box style={{ width: '8px', height: '8px', borderRadius: '50%', background: '#3B82F6' }} />
          <Text style={{ fontSize: 18, color: '#F1F5F9' }}>Blind, uses NVDA</Text>
        </Box>
        <Box style={{ flexDirection: 'row', gap: '12px', alignItems: 'center' }}>
          <Box style={{ width: '8px', height: '8px', borderRadius: '50%', background: '#3B82F6' }} />
          <Text style={{ fontSize: 18, color: '#F1F5F9' }}>Subang Jaya / LRT</Text>
        </Box>
        <Box style={{ flexDirection: 'row', gap: '12px', alignItems: 'center' }}>
          <Box style={{ width: '8px', height: '8px', borderRadius: '50%', background: '#3B82F6' }} />
          <Text style={{ fontSize: 18, color: '#F1F5F9' }}>RM12/hr minimum</Text>
        </Box>
        <Box style={{ flexDirection: 'row', gap: '12px', alignItems: 'center' }}>
          <Box style={{ width: '8px', height: '8px', borderRadius: '50%', background: '#3B82F6' }} />
          <Text style={{ fontSize: 18, color: '#F1F5F9' }}>Phone interviews</Text>
        </Box>
        <Box style={{ flexDirection: 'row', gap: '12px', alignItems: 'center' }}>
          <Box style={{ width: '8px', height: '8px', borderRadius: '50%', background: '#10B981' }} />
          <Text style={{ fontSize: 18, color: '#F1F5F9' }}>Weekdays 9 to 5</Text>
        </Box>
      </Box>
    </Box>
  </Box>
  <Box style={{ height: '40px', flexDirection: 'row', justifyContent: 'space-between', alignItems: 'flex-end' }}>
    <Text style={{ fontSize: 14, color: '#475569' }}>HireBuddy</Text>
    <Text style={{ fontSize: 14, color: '#475569' }}>02 / 05</Text>
  </Box>
</Slide>
